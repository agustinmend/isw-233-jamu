<div id="habilidades" class="habilidades">
    <h2 class="habilidades__encabezado">Habilidades</h2>
    <div class="habilidades__segmentos">
        {{> habilidad-segmento 
            icono="fa-code" 
            titulo="Desarrollador frontend" 
            texto="Experiencia basica en desarrollo de frontend, conocimiento basico en herramientas de frontend" 
            titulo-herramientas="herramientas de desarrollo" 
            lista-items="<li>Angular</li><li>React</li>" 
        }}

        {{> habilidad-segmento 
            icono="fa-server" 
            titulo="Desarrollador Backend" 
            texto="Experiencia basica en desarrollo de Backend, conocimiento de conceptos basicos" 
            titulo-herramientas="herramientas de desarrollo" 
            lista-items="<li>.Net</li><li>Node.js</li><li>Python</li><li>SQL</li><li>MongoDB</li>" 
        }}

        {{> habilidad-segmento 
            icono="fa-screwdriver-wrench" 
            titulo="Otras habilidades" 
            texto="Poseo habilidades extras como buen trabajo en equipo y manejo de otras herramientas" 
            titulo-herramientas="herramientas que uso" 
            lista-items="<li>Miro</li><li>Git</li>" 
        }}
    </div>
</div>